# Порт и хост для запуска приложения (по умолчанию 0.0.0.0:8099)
PULSEFIT_ADDR=0.0.0.0:8099

# Каталог для хранения базы данных SQLite store.db
PULSEFIT_DATA=data

# Опционально: API-ключ для внешнего ИИ (OpenAI / Anthropic).
# Если не задан, приложение работает в автономном встроенном режиме со всеми сценариями!
PULSEFIT_AI_KEY=
